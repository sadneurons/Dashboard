---
import type { WidgetMeta } from '../lib/widgets';

export const meta: WidgetMeta = {
  title: 'BMI',
  category: 'Calculators',
  keywords: ['body mass index', 'weight', 'height', 'obesity'],
  order: 2,
};
---

<form data-bmi novalidate>
  <div class="w-fields">
    <label class="w-field">
      Height
      <span class="w-unit"><input class="w-input" name="height" type="number" inputmode="decimal" min="0" step="any" /> cm</span>
    </label>
    <label class="w-field">
      Weight
      <span class="w-unit"><input class="w-input" name="weight" type="number" inputmode="decimal" min="0" step="any" /> kg</span>
    </label>
  </div>
  <output class="w-result" aria-live="polite">
    <span class="w-value" data-bmi-value></span>
    <span class="w-band" data-bmi-band>Enter height and weight</span>
  </output>
</form>

<script>
  import { bmi, bmiCategory } from '../lib/bmi';

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-bmi]')) {
    const height = form.elements.namedItem('height') as HTMLInputElement;
    const weight = form.elements.namedItem('weight') as HTMLInputElement;
    const value = form.querySelector<HTMLElement>('[data-bmi-value]')!;
    const band = form.querySelector<HTMLElement>('[data-bmi-band]')!;

    const update = () => {
      const result = bmi(weight.valueAsNumber, height.valueAsNumber);
      const filled = height.value !== '' && weight.value !== '';
      value.textContent = result === null ? '' : result.toFixed(1);
      band.textContent =
        result !== null
          ? bmiCategory(result)
          : filled
            ? 'Check the values: height in cm, weight in kg'
            : 'Enter height and weight';
    };

    form.addEventListener('input', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    update();
  }
</script>
