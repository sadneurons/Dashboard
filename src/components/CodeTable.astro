---
import type { CodeGroup } from '../lib/codes';

interface Props {
  groups: CodeGroup[];
}

const { groups } = Astro.props;
const systems = [
  { key: 'snomed', label: 'SNOMED CT' },
  { key: 'icd10', label: 'ICD-10' },
  { key: 'icd11', label: 'ICD-11' },
] as const;
---

<div class="scroll" tabindex="0" role="region" aria-label="Code table">
  <table data-code-table>
    <thead>
      <tr>
        <th scope="col">Condition</th>
        {systems.map((system) => <th scope="col">{system.label}</th>)}
      </tr>
    </thead>
    {
      groups.map(({ group, conditions }) => (
        <tbody data-item-group>
          <tr class="group">
            <th colspan="4" scope="rowgroup">
              {group}
            </th>
          </tr>
          {conditions.map((condition) => (
            <tr
              data-item
              data-search={[
                condition.name,
                ...condition.also,
                condition.snomed,
                ...condition.icd10,
                ...condition.icd11,
                condition.note,
                group,
              ]
                .join(' ')
                .toLowerCase()}
            >
              <th scope="row">
                {condition.name}
                {condition.note && <small>{condition.note}</small>}
              </th>
              {systems.map((system) => {
                const codes = [condition[system.key]].flat();
                return (
                  <td data-label={system.label}>
                    {codes.length === 0 ? (
                      <span class="none" aria-label="No code">
                        –
                      </span>
                    ) : (
                      codes.map((code) => (
                        <button
                          type="button"
                          data-copy={code}
                          title={`Copy ${system.label} ${code}`}
                        >
                          {code}
                        </button>
                      ))
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</div>
<p class="status" role="status" data-copy-status></p>

<script>
  for (const table of document.querySelectorAll<HTMLElement>('[data-code-table]')) {
    const status = table.closest('.content, body')?.querySelector<HTMLElement>('[data-copy-status]');

    table.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
      const code = button?.dataset.copy;
      if (!button || !code) return;
      try {
        await navigator.clipboard.writeText(code);
        if (status) status.textContent = `Copied ${code}`;
        button.dataset.copied = '';
        setTimeout(() => delete button.dataset.copied, 1200);
      } catch {
        // Clipboard access can be refused; select the code so Ctrl+C still works.
        const range = document.createRange();
        range.selectNodeContents(button);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        if (status) status.textContent = `Press Ctrl+C to copy ${code}`;
      }
    });
  }
</script>

<style>
  .scroll {
    max-height: 30rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--sheet);
    box-shadow: 0 1px 0 var(--line);
    white-space: nowrap;
  }

  .group th {
    padding-top: 0.8rem;
    font-size: 0.8125rem;
    font-weight: 700;
    background: var(--page);
  }

  tbody th[scope='row'] {
    font-weight: 500;
  }

  small {
    display: block;
    margin-top: 0.15rem;
    max-width: 44ch;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  td {
    white-space: nowrap;
  }

  button {
    display: block;
    padding: 0.05rem 0.4rem;
    font-variant-numeric: tabular-nums;
    background: none;
    border: 1px solid transparent;
    border-radius: 3px;
    cursor: copy;
  }

  button + button {
    margin-top: 0.15rem;
  }

  button:hover {
    border-color: var(--edge);
  }

  button[data-copied] {
    background: var(--mark);
  }

  .none {
    padding: 0 0.4rem;
    color: var(--ink-soft);
  }

  .status {
    min-height: 1.3rem;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  /* Narrow cards: each condition becomes a stacked block with labelled codes. */
  @container (max-width: 34rem) {
    thead {
      display: none;
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    tr[data-item] {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--line);
    }

    tbody th,
    td {
      border: 0;
      padding: 0.15rem 0.6rem;
    }

    td {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.15rem 0.4rem;
    }

    td::before {
      content: attr(data-label);
      width: 5.5rem;
      font-size: 0.8125rem;
      color: var(--ink-soft);
    }

    button + button {
      margin-top: 0;
    }
  }
</style>
